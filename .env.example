APP_NAME="NMP Support Ticketing System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:4000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nmp_ticketing
DB_USERNAME=root
DB_PASSWORD=2026nmpict

PAMANA_DB_DATABASE=pamana_employees_new
PAMANA_DB_HOST=127.0.0.1
PAMANA_DB_PORT=3306
PAMANA_DB_USERNAME=root
PAMANA_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Upload disk. local writes UPLOAD_DIR (shared with the PDF worker).
# On EC2/ECS set UPLOADS_DISK=s3 and the AWS_* values. Objects stay private;
# the app streams them at /uploads/{filename}.
UPLOADS_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_UPLOADS_PREFIX=uploads

# Multi-instance production: point session, cache, and queue at a shared store
# (RDS or ElastiCache) so tasks do not depend on local disk.
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=database

# firebase/php-jwt HS256 requires >= 32 bytes
JWT_SECRET=change-me-in-production-nmp-ticketing
UPLOAD_DIR=/home/ysa/dev/National-Museum-SupportTicketing-System/backend/uploads
REALTIME_URL=http://127.0.0.1:4001
REALTIME_INTERNAL_SECRET=change-me-in-production-nmp-ticketing

CORS_ORIGIN=http://127.0.0.1:5173

# Leave empty in dev — Vite proxies /api to the Laravel app.
VITE_API_URL=
VITE_CLIENT_FEEDBACK_URL=https://feedback.nationalmuseum.gov.ph/survey/client-satisfaction-survey/form
VITE_ALLOWED_HOSTS=on-prem.x-dcb.net,localhost,127.0.0.1,202.90.136.222,10.138.21.235
