{
  "name": "nmpticketing",
  "private": true,
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "dev": "bash ./scripts/start-dev.sh",
    "dev:web": "bun run --cwd frontend dev",
    "start": "bash ./scripts/start-dev.sh",
    "dev:api": "bun run --cwd backend dev",
    "seed": "bun run --cwd backend seed",
    "build": "bun run --cwd backend build && bun run --cwd frontend build",
    "verify": "bash ./scripts/verify-system.sh",
    "build:dev": "bun run --cwd frontend build:dev",
    "preview": "bun run --cwd frontend preview",
    "lint": "bun run --cwd frontend lint",
    "format": "bun run --cwd frontend format"
  }
}
